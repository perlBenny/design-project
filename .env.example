# Copy to .env.dev (and later .env.prod) and replace the values.
# Never commit real env files. Only this file is committed.

NODE_ENV=development

# --- Postgres ---
POSTGRES_USER=admin
# Dev and CI only. Never use these values anywhere else.
POSTGRES_PASSWORD=password
POSTGRES_DB=designer_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://admin:password@localhost:5432/designer_dev?sslmode=disable
# pgAdmin web UI (pnpm db:ui), localhost only
PGADMIN_PORT=5050
# Load sample projects and tips (db/seed/dev.sql). Must be false in prod.
SEED_SAMPLE_DATA=true

# --- Storage (S3 API: RustFS in dev, R2 or S3 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=designer-images
S3_ACCESS_KEY=storage-admin
S3_SECRET_KEY=change-me-at-least-8-chars
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Auth ---
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Frontend ---
API_URL=http://localhost:4000/api/v1
