# Copy to .env.dev / .env.prod and fill in real values. Never commit real env files.

NODE_ENV=development

# Database
DATABASE_URL=postgres://designer:change-me@localhost:5432/designer_dev?sslmode=disable

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Storage (S3 API / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=designer-images
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Frontend
API_URL=http://localhost:4000/api/v1
