{
  "name": "design-project",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "infra:up": "docker compose --env-file .env.dev up -d --wait",
    "infra:down": "docker compose --env-file .env.dev down",
    "infra:logs": "docker compose --env-file .env.dev logs -f",
    "db:migrate": "docker compose --env-file .env.dev run --rm dbmate up",
    "db:rollback": "docker compose --env-file .env.dev run --rm dbmate rollback",
    "db:status": "docker compose --env-file .env.dev run --rm dbmate status",
    "db:new": "docker compose --env-file .env.dev run --rm dbmate new",
    "db:seed": "docker compose --env-file .env.dev run --rm seed",
    "db:test": "docker compose --env-file .env.dev run --rm --entrypoint psql seed -q -f /tests/constraints.sql",
    "db:reset": "docker compose --env-file .env.dev run --rm dbmate drop && pnpm db:migrate && pnpm db:seed",
    "dev": "pnpm infra:up && pnpm db:migrate && pnpm db:seed && pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "devDependencies": {
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
